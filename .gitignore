# Data storage (keep directories via .gitkeep, ignore generated datasets)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
!data/interim/phase13_steps2_4/
!data/interim/phase13_steps2_4/**
!data/interim/phase14_shadow/
!data/interim/phase14_shadow/**
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep
data/shadow/raw_captures/*
!data/shadow/raw_captures/.gitkeep

