# ==============================================================================
# NIFTY AI - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows PowerShell: Copy-Item .env.example .env)
# 2. Update the environment variables below for your local environment.
# 3. NEVER commit the .env file or real credentials to version control.
# ==============================================================================

# Project Environment: development | staging | production
NIFTY_AI_ENV=development

# Logging Configuration: DEBUG | INFO | WARNING | ERROR | CRITICAL
NIFTY_AI_LOG_LEVEL=INFO

# Base Timezone for Market Operations (IST)
NIFTY_AI_TIMEZONE=Asia/Kolkata

# Project Paths (Defaults will resolve relative to project root if left empty)
NIFTY_AI_DATA_DIR=data
NIFTY_AI_CONFIG_DIR=configs
NIFTY_AI_ARTIFACTS_DIR=artifacts
NIFTY_AI_LOGS_DIR=logs

# Active Data Provider Selection
NIFTY_AI_MARKET_PROVIDER=yahoo_finance
NIFTY_AI_MACRO_PROVIDER=macro_composite
NIFTY_AI_NEWS_PROVIDER=news_composite

# ------------------------------------------------------------------------------
# Future Integration Placeholders (Do NOT populate with production keys here)
# ------------------------------------------------------------------------------
# Market Data Provider
# MARKET_DATA_API_KEY=
# MARKET_DATA_API_SECRET=

# Broker / Paper Trading Integration
